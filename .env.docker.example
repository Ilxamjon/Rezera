# Copy to `.env` before `docker compose up` (never commit real secrets).
# Generate key: docker compose run --rm -e RUN_MIGRATIONS=0 app php artisan key:generate --show

APP_NAME=Rezera
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rezera
DB_USERNAME=rezera
DB_PASSWORD=change_me_strong_password
DB_TIMEZONE=UTC

CACHE_STORE=redis
CACHE_PREFIX=rezera_
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

CORS_ALLOWED_ORIGINS=*

API_RATE_LIMIT=60
API_AUTH_RATE_LIMIT=10
API_BOOKING_RATE_LIMIT=20

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.uz"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_MOCK_ENABLED=false
PAYMENT_MOCK_ALLOW_SIMULATION=false

BUSINESS_PUBLIC_REQUIRES_VERIFICATION=true
BUSINESS_PUBLIC_REQUIRES_ONBOARDING_COMPLETE=true
# Auto-publish after owner submits verification (set false for strict review)
BUSINESS_AUTO_PUBLISH_ON_VERIFICATION_SUBMIT=false

NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_PUSH_DRIVER=mock
NOTIFICATION_EMAIL_ENABLED=false

SEED_DEMO_CLUB=false

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

FILESYSTEM_DISK=local

# Docker compose extras
HTTP_PORT=8080
RUN_MIGRATIONS=1
CACHE_CONFIG=1
