{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/auto-sync-github.ps1 -Reason stop",
        "timeout": 120
      }
    ],
    "afterFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/auto-sync-github.ps1 -Reason edit",
        "timeout": 120
      }
    ]
  }
}
