APP_NAME=Rezera
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.example.uz

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rezera
DB_USERNAME=rezera_app
DB_PASSWORD=
DB_TIMEZONE=UTC

CACHE_STORE=redis
CACHE_PREFIX=rezera_prod_
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

CORS_ALLOWED_ORIGINS=

API_RATE_LIMIT=60
API_AUTH_RATE_LIMIT=10
API_BOOKING_RATE_LIMIT=20

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.uz"
MAIL_FROM_NAME="${APP_NAME}"

# Beta MVP: pay at venue — keep mock off
PAYMENT_MOCK_ENABLED=false
PAYMENT_MOCK_ALLOW_SIMULATION=false

BUSINESS_PUBLIC_REQUIRES_VERIFICATION=true
BUSINESS_PUBLIC_REQUIRES_ONBOARDING_COMPLETE=true

NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_PUSH_DRIVER=mock
NOTIFICATION_EMAIL_ENABLED=true

# Never seed demo passwords in production
SEED_DEMO_CLUB=false

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

FILESYSTEM_DISK=local
