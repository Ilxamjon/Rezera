APP_NAME=Rezera
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

# Supported user-facing locales (Flutter + user profile)
REZERA_SUPPORTED_LOCALES=uz,kaa,ru
REZERA_DEFAULT_LOCALE=ru
REZERA_DEFAULT_BUSINESS_TIMEZONE=Asia/Tashkent
REZERA_DEFAULT_CURRENCY=UZS

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required for production and recommended for local development.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rezera
DB_USERNAME=rezera
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=rezera_

# Sanctum — mobile API tokens
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_PREFIX=

# CORS — comma-separated origins for Flutter/web clients
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API rate limits (requests per minute)
API_RATE_LIMIT=60
API_AUTH_RATE_LIMIT=10
API_BOOKING_RATE_LIMIT=20

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@rezera.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
