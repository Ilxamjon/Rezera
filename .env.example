APP_NAME=Rezera
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

# Supported user-facing locales (Flutter + user profile)
REZERA_SUPPORTED_LOCALES=uz,kaa,ru
REZERA_DEFAULT_LOCALE=ru
REZERA_DEFAULT_BUSINESS_TIMEZONE=Asia/Tashkent

# Auto-approve & list businesses after owner submits verification (true outside production by default).
# BUSINESS_AUTO_PUBLISH_ON_VERIFICATION_SUBMIT=true
# BUSINESS_PUBLIC_REQUIRES_VERIFICATION=true
# BUSINESS_PUBLIC_REQUIRES_ONBOARDING_COMPLETE=true
REZERA_DEFAULT_CURRENCY=UZS

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required for production and recommended for local development.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rezera
DB_USERNAME=rezera
DB_TIMEZONE=UTC
# Required for PostgreSQL auth. Leave empty only if your local PG user has trust auth.
DB_PASSWORD=3855750

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=rezera_

# Sanctum — mobile API tokens (default: 30 days; set explicitly in production)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_PREFIX=
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# Payment mock provider (local/testing only)
PAYMENT_MOCK_WEBHOOK_SECRET=

# CORS — comma-separated origins for Flutter/web clients
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API rate limits (requests per minute)
API_RATE_LIMIT=60
API_AUTH_RATE_LIMIT=10
API_BOOKING_RATE_LIMIT=20

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@rezera.local"
MAIL_FROM_NAME="${APP_NAME}"

# Notifications — in-app is always on. Push stays off until FCM credentials exist.
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_TELEGRAM_ENABLED=false
NOTIFICATION_PUSH_DRIVER=mock
# NOTIFICATION_PUSH_DRIVER=fcm
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_PATH=storage/app/firebase-credentials.json
# Do not put the service-account JSON in git. See docs/NOTIFICATION_ARCHITECTURE.md.

# Demo seed (Neon Arena + Pixel Hub). Default: on in local, off otherwise.
# SEED_DEMO_CLUB=true
# php artisan db:seed --class=Database\\Seeders\\DemoClubSeeder

# Sentry — leave empty locally; set DSN in staging/production
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

VITE_APP_NAME="${APP_NAME}"
